{
  "name": "classroom-hub",
  "version": "1.0.0",
  "private": true,
  "description": "A secure school learning portal for notes and exercises.",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand tests/integration.test.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "recover-admin": "node scripts/recoverAdmin.js",
    "check-indexes": "node scripts/checkIndexes.js",
    "load": "node scripts/loadTest.js",
    "secret-scan": "node scripts/secretScan.js"
  },
  "dependencies": {
    "bcrypt": "5.1.1",
    "compression": "1.7.4",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-mongo-sanitize": "2.2.0",
    "express-rate-limit": "7.5.0",
    "hpp": "0.2.3",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.9.5",
    "multer": "2.5.0",
    "node-cron": "3.0.3",
    "nodemailer": "6.10.0",
    "pino": "9.6.0",
    "sanitize-html": "2.14.0",
    "sharp": "0.33.5",
    "speakeasy": "2.0.0",
    "@sentry/node": "8.47.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "mongodb-memory-server": "10.1.4",
    "supertest": "7.0.0"
  }
}
