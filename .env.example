# Copy to .env and replace every value before starting the app.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/classroom_hub
JWT_ACCESS_SECRET=replace-with-a-random-value-at-least-32-characters-long
JWT_REFRESH_SECRET=replace-with-a-different-random-value-at-least-32-characters
DATA_ENCRYPTION_KEY=replace-with-32-random-base64url-characters
ADMIN_SEED_NAME=School Administrator
ADMIN_SEED_EMAIL=admin@example.edu
ADMIN_SEED_PASSWORD=replace-this-with-the-approved-initial-password
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Classroom Hub <no-reply@example.edu>
PUBLIC_BASE_URL=http://localhost:3000
BACKUP_ENCRYPTION_KEY=replace-with-64-random-hex-characters
MONGODUMP_PATH=mongodump
MONGORESTORE_PATH=mongorestore
SENTRY_DSN=
MONGO_INITDB_ROOT_USERNAME=classroom-local
MONGO_ROOT_PASSWORD=replace-with-a-strong-local-database-password
